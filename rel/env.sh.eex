#!/bin/sh
# Erlang distribution: long name on loopback only, and a cookie the BOX
# supplies. A mix release otherwise ships the cookie it generated at build
# time, the same for every container of this public image.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${RELEASE_NODE:-mcl_kanban@127.0.0.1}"
export ERL_EPMD_ADDRESS=127.0.0.1

if [ -z "${MCL_COOKIE:-}" ]; then
  echo "mcl-kanban: MCL_COOKIE is not set; give this box its own cookie (see the fleet repo)" >&2
  exit 1
fi

export RELEASE_COOKIE="${MCL_COOKIE}"
